# Copia este archivo como .env.local y pega los valores de tu proyecto.
# Están en Supabase → Project Settings → Data API / API Keys.
#
# Este proyecto es Vite + React, no Next.js: las variables DEBEN empezar con
# VITE_ o el navegador no las verá.
#
# La "anon key" (o "publishable key") es pública por diseño: viaja al navegador
# y está protegida por las políticas RLS del archivo supabase/migrations.
# NUNCA pongas aquí la "service_role key" ni valores reales: este archivo se
# comparte, los valores de verdad van en .env.local.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
